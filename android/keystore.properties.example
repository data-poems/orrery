# File purpose: Document the local-only Android release signing configuration.
# Primary entries: Keystore path, store password, key alias, and key password.
# I/O: Copy to keystore.properties and replace placeholders; Gradle reads it
# locally, while the real properties file and keystore remain gitignored.
storeFile=/absolute/path/to/orrery-release.keystore
storePassword=<store-password>
keyAlias=<key-alias>
keyPassword=<key-password>
