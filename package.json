{
  "name": "orrery-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:web",
    "build:web": "tsc -b && vite build && node scripts/postbuild-observatory-html.mjs && node scripts/postgzip.mjs",
    "build:ios": "tsc -b && VITE_CAPACITOR=true vite build --base=./",
    "ios:sync": "pnpm build:ios && cap sync ios",
    "ios:open": "cap open ios",
    "lint": "eslint .",
    "preview": "vite preview",
    "prebake": "tsx scripts/prebake.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/three": "^0.183.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "satellite.js": "^6.0.2",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0"
  }
}
