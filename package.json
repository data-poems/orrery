{
  "name": "orrery-app",
  "private": true,
  "version": "1.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:web",
    "build:web": "tsc -b && vite build && node scripts/postbuild-observatory-html.mjs && node scripts/postgzip.mjs",
    "build:ios": "tsc -b && VITE_CAPACITOR=true vite build --base=./ && node scripts/postbuild-ios-html.mjs",
    "ios:sync": "pnpm build:ios && cap sync ios",
    "ios:compile": "pnpm ios:sync && xcodebuild -project ios/App/App.xcodeproj -scheme Orrery -destination 'generic/platform=iOS' -configuration Debug build CODE_SIGNING_ALLOWED=NO",
    "ios:open": "cap open ios",
    "build:android": "tsc -b && VITE_CAPACITOR=true vite build --base=./ && node scripts/postbuild-ios-html.mjs",
    "android:sync": "pnpm build:android && cap sync android",
    "android:apk": "pnpm android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "pnpm android:sync && cd android && ./gradlew clean stageReleaseArtifacts",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "prebake": "tsx scripts/prebake.ts",
    "build:mobile": "tsc -b && vite build"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/xr": "^6.6.30",
    "@types/three": "^0.183.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "satellite.js": "^6.0.2",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vitest": "^4.1.6"
  }
}
